# ==========================================
# GITIGNORE - SIDIK (DEFENSIVE SHIELD TNI AD)
# ==========================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
data/keys/
# Database SQLite lokal (jalan tanpa Docker)
*.db

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/backend/lib/
/backend/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Computer Vision & OCR Temporary Storage
data/test_leaks/*
data/watermarked_outputs/*
!data/test_leaks/.gitkeep
!data/watermarked_outputs/.gitkeep
!data/master_templates/

# Video demo (proyek Remotion dan hasil render) tidak masuk git
/video/
*.mp4
*.mov
*.mkv
*.webm
*.avi

# Node.js & Next.js
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/
frontend/AGENTS.md

# Hasil rakitan paket Hugging Face Space (dibuat oleh deploy/make_hf_space.py)
deploy/_hf_space_out/

# Panduan operasional tim (akun, rahasia, langkah push): tetap lokal, tidak masuk repo
docs/*.local.md

# Paket juri rakitan (deploy/make_juri_package.py)
deploy/_juri_out/
