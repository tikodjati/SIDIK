# Salin ke .env (jangan di-commit). Semua nilai di bawah hanya untuk pengembangan lokal.
POSTGRES_PASSWORD=sidik
SIDIK_DATABASE_URL=postgresql+psycopg://sidik:sidik@localhost:5432/sidik
SIDIK_SIGNING_KEY_PATH=data/keys/ledger_ed25519.pem
NEXT_PUBLIC_API_URL=http://localhost:8000
# Wajib true bila dilayani lewat HTTPS.
SIDIK_COOKIE_SECURE=false
SIDIK_SESSION_HOURS=8

# Database bersama tim (Neon), dipakai Docker. Kosongkan untuk database lokal di container.
# SIDIK_SHARED_DATABASE_URL=postgresql://USER:SANDI@HOST.neon.tech/sidik?sslmode=require
# SIDIK_SIGNING_KEY_FILE=ledger_tim_ed25519.pem
# SIDIK_SIGNING_KEY_AUTOCREATE=false
